# Copy to .env and fill in. Never commit .env.

# exchangerate.dev — optional. Without a key: 10 req/min, 100 req/hour per IP.
# With a free key: 5,000 calls/month, 10 req/min. Sent as "Authorization: Bearer <key>".
PROVIDER_API_KEY=
PROVIDER_BASE_URL=https://api.exchangerate.dev/v1
PROVIDER_MONTHLY_LIMIT=5000
PROVIDER_PER_MINUTE_LIMIT=10

# Redis (docker-compose overrides this to redis://redis:6379/0)
REDIS_URL=redis://localhost:6379/0

# Collector
# Market-aware schedule: FX open (Sun 22:00 -> Fri 22:00 UTC) vs closed.
TRADING_INTERVAL_SECONDS=600
NON_TRADING_INTERVAL_SECONDS=900
# Stretch interval if projected calls would exceed 90% of monthly budget.
BUDGET_SAFETY=0.9
FREE_UPDATE_EVERY_N=5
PREMIUM_UPDATE_EVERY_N=1
INTERNAL_PER_MINUTE_LIMIT=10

# Sliding window / fallback
WINDOW_SIZE=15
EWMA_ALPHA=0.4
EWMA_MIN_OBSERVATIONS=3
MAX_DATA_AGE_SECONDS=21600

# Demo simulations (keep false in production)
DEMO_MODE=true
DEMO_DURATION_SECONDS=120
DEMO_STAGE_SECONDS=8

CORS_ORIGINS=http://localhost:5173,http://localhost:8080
