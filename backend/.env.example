# Infrastructure
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
LOG_LEVEL=INFO

# Provider (exchangerate.dev). API key optional; sent as "Authorization: Bearer <key>" only when set.
PROVIDER_NAME=exchangerate.dev
PROVIDER_BASE_URL=https://api.exchangerate.dev/v1
PROVIDER_API_KEY=
PROVIDER_TIMEOUT_SECONDS=10
PROVIDER_MAX_RETRIES=2
PROVIDER_BACKOFF_SECONDS=1
PROVIDER_MONTHLY_LIMIT=5000
PROVIDER_PER_MINUTE_LIMIT=10
PROVIDER_DOCS_URL=https://exchangerate.dev/free-plan-limits
PROVIDER_ATTRIBUTION_URL=https://exchangerate.dev

# Collector
# Market-aware schedule: OPEN Sun 22:00 -> Fri 22:00 UTC uses TRADING, weekend uses NON_TRADING.
TRADING_INTERVAL_SECONDS=600
NON_TRADING_INTERVAL_SECONDS=900
# Budget guard: interval stretched to seconds_left_in_month / ((limit - used) * BUDGET_SAFETY) if larger.
BUDGET_SAFETY=0.9
# Legacy alias: if set, overrides BOTH intervals above. Leave empty for market-aware scheduling.
COLLECTION_INTERVAL_SECONDS=
COLLECTOR_ENABLED=true
COLLECTOR_LOCK_TTL_SECONDS=120
INTERNAL_PER_MINUTE_LIMIT=10

# Tier refresh policy
FREE_UPDATE_EVERY_N=5
PREMIUM_UPDATE_EVERY_N=1

# Sliding window / fallback
WINDOW_SIZE=15
WINDOW_TTL_SECONDS=604800
EWMA_ALPHA=0.4
EWMA_MIN_OBSERVATIONS=3
MAX_DATA_AGE_SECONDS=21600

# Demo simulations (endpoints return 403 unless true)
DEMO_MODE=false
DEMO_STAGE_SECONDS=8
DEMO_DURATION_SECONDS=120
DEMO_RECOVERY_SECONDS=60
